{
  "name": "smart-library-management",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "build": "node scripts/db-setup.mjs && next build",
    "dev": "node scripts/db-setup.mjs && next dev",
    "lint": "eslint .",
    "start": "next start",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push --skip-generate",
    "postinstall": "prisma generate",
    "kiosk": "npm run build && electron electron/main.js",
    "kiosk:dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.donbosco.librarykiosk",
    "productName": "Library Kiosk",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      ".next/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-accordion": "^1.1.1",
    "@radix-ui/react-alert-dialog": "^1.1.2",
    "@radix-ui/react-aspect-ratio": "^1.1.1",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-collapsible": "^1.1.2",
    "@radix-ui/react-context-menu": "^2.1.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-hover-card": "^1.0.7",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-menubar": "^1.0.4",
    "@radix-ui/react-navigation-menu": "^1.1.4",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-radio-group": "^1.1.3",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-toggle": "^1.0.3",
    "@radix-ui/react-toggle-group": "^1.0.4",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@vercel/analytics": "^1.1.1",
    "autoprefixer": "^10.4.20",
    "axios": "1.13.4",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^0.2.1",
    "date-fns": "^2.30.0",
    "dotenv": "^17.3.1",
    "embla-carousel-react": "^8.0.0",
    "framer-motion": "^12.35.1",
    "input-otp": "^1.2.4",
    "jose": "^6.1.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.454.0",
    "next": "16.0.10",
    "next-themes": "^0.2.1",
    "node-cron": "^3.0.2",
    "node-hid": "^3.3.0",
    "nodemailer": "^6.9.7",
    "react": "19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.51.3",
    "react-resizable-panels": "^2.0.3",
    "react-to-pdf": "^3.2.1",
    "react-to-print": "^3.3.0",
    "recharts": "^2.10.3",
    "resend": "^6.9.3",
    "sonner": "^1.3.1",
    "speakeasy": "^2.0.0",
    "swr": "^2.4.0",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.0.1",
    "xlsx": "^0.18.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22",
    "@types/node-cron": "^3.0.11",
    "@types/node-hid": "^1.3.4",
    "@types/nodemailer": "^6.4.14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/speakeasy": "^2.0.10",
    "concurrently": "^9.2.1",
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.1.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
